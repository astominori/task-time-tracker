# pnpm security settings (Shai-Hulud worm countermeasure)

# Prevent dependency hoisting — strict isolation between packages
hoist=false
shamefully-hoist=false

# Disallow lifecycle scripts from dependencies (install/postinstall hooks)
ignore-scripts=true

# Ensure lockfile is always up-to-date (fail if out of sync)
frozen-lockfile=true

# Prevent packages from accessing dependencies they didn't declare
strict-peer-dependencies=false
resolve-peers-from-workspace-root=true

# Only allow packages from the registry (prevent local path injection)
prefer-workspace-packages=false
